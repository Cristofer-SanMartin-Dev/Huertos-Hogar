# Copiar a ".env" en esta misma carpeta y completar con datos reales.
# Nunca subir el ".env" real al repo (ya está en .gitignore).

# --- Correo (recuperación de contraseña y notificaciones de pedido) ---
# Se envía por la API HTTP de Brevo (no SMTP): varios hosts free, incluido
# Render, bloquean las conexiones SMTP salientes. Creá una cuenta gratis en
# https://brevo.com, verificá una dirección de remitente ("Single Sender",
# no hace falta un dominio propio) y generá una API key en el dashboard.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# Debe ser exactamente la dirección que verificaste como Single Sender.
MAIL_FROM=tu-correo-verificado@ejemplo.com
MAIL_FROM_NAME=HuertoHogar

# --- Base de datos ---
# Contraseña de tu PostgreSQL local (usuario "postgres").
DB_PASSWORD=tu-contraseña-de-postgres

# --- Imágenes de producto (Cloudinary) ---
# Creá una cuenta gratis en https://cloudinary.com — en el dashboard te dan
# esta URL ya armada (Account Details → API Environment variable), no hay
# que construirla a mano.
CLOUDINARY_URL=cloudinary://tu-api-key:tu-api-secret@tu-cloud-name
