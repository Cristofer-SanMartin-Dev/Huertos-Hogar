# Copiar a ".env" en esta misma carpeta y completar con datos reales.
# Nunca subir el ".env" real al repo (ya está en .gitignore).

# --- Correo (recuperación de contraseña) ---
# Con Gmail: MAIL_USERNAME es tu cuenta completa (usuario@gmail.com) y
# MAIL_PASSWORD es una "contraseña de aplicación" de 16 caracteres generada en
# https://myaccount.google.com/apppasswords — NO tu contraseña normal de Gmail
# (con la contraseña normal el login SMTP falla si tienes verificación en dos
# pasos, que es obligatoria para poder generar contraseñas de aplicación).
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tu-correo@gmail.com

# --- Base de datos ---
# Solo si tu PostgreSQL local pide contraseña para conectar (con pg_hba.conf
# en modo "trust" para 127.0.0.1, que es lo más común en una instalación
# default, ni siquiera hace falta esta variable).
# DB_PASSWORD=tu-contraseña-de-postgres
