# Copiar a ".env" en esta misma carpeta y completar con datos reales.
# Nunca subir el ".env" real al repo (ya está en .gitignore).

# --- Correo (recuperación de contraseña) ---
# Se envía por la API HTTP de Resend (no SMTP): varios hosts free, incluido
# Render, bloquean las conexiones SMTP salientes. Creá una cuenta gratis en
# https://resend.com y generá una API key en el dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# "onboarding@resend.dev" funciona sin verificar un dominio propio (útil para
# desarrollo/demo). En modo prueba, Resend solo entrega a la casilla con la
# que te registraste en resend.com — para enviarle a cualquier usuario real
# hay que verificar un dominio propio en Resend.
MAIL_FROM=onboarding@resend.dev

# --- Base de datos ---
# Contraseña de tu PostgreSQL local (usuario "postgres").
DB_PASSWORD=tu-contraseña-de-postgres
